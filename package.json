{
  "name": "myworkspace",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
	"create-org": "tsx scripts/create-org.ts",
    "dev": "tsx src/http/server.ts",
	"build": "tsc -p tsconfig.build.json",
	"start": "node dist/src/http/server.js",
	"preflight": "node dist/scripts/preflight.js",
	"migrate:prod": "node dist/scripts/migrate-prod.js"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
