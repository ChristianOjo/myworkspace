# Set this to the API server origin (without /api/v1).
# The production frontend's exact origin must be included in the API's CORS_ORIGINS.
VITE_API_BASE_URL=http://127.0.0.1:3000

# Optional: pin the customer portal's workspace slug at build time. When empty,
# the portal calls GET /public/default-org for the single deployed workspace
# and hides the slug field; manual entry remains as a fallback otherwise.
VITE_DEFAULT_ORG_SLUG=
