# .env.example
# Node environment (development or production)
NODE_ENV=development

# Server port (1-65535)
PORT=3000

# Server host (127.0.0.1 for development, 0.0.0.0 for production)
HOST=127.0.0.1

# Database connection string for owner role (used for migrations and preflight only)
DATABASE_URL=postgres://myworkspace:myworkspace@localhost:5432/myworkspace

# Database connection string for app role (used by the server, must be different from DATABASE_URL in production)
APP_DATABASE_URL=postgres://app_user:app_user@localhost:5432/myworkspace

# Database SSL mode: off, require, or no-verify
DB_SSL=off

# Database connection pool size (1-50)
DB_POOL_MAX=10

# CORS allowed origins (comma-separated, no wildcards in production)
CORS_ORIGINS=

# Trust proxy headers (true or false)
TRUST_PROXY=false

# Directory containing the built web app (enables static file serving)
STATIC_DIR=

# Background job scheduler (on or off)
SCHEDULER=on

# Password for app_user role (used by migrate-prod script, 16-200 characters)
APP_USER_PASSWORD=